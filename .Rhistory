GOOGL_peaksCHECK <- find_peaks(Cl(GOOGL))
find_peaks <- function(data) {
price <- Cl(data)
prev  <- lag(price, 1)
nexts <- lead(price, 1)
peaks <- (price > prev) & (price > nexts)
peaks_data <- data[peaks]
return(peaks_data)
}
GOOGL_peaksCHECK <- find_peaks(Cl(GOOGL))
hist( dailyReturn(Cl(GOOGL_peaksCHECK)) )
plot(GOOGL_peaksCHECK)
GOOGL_peaks1 <- find_peaks(Cl(GOOGL))
GOOGL_peaksCHECK <- find_peaks(Cl(GOOGL_peaks1))
plot(GOOGL_peaksCHECK)
hist( dailyReturn(Cl(GOOGL_peaksCHECK)) )
hist( dailyReturn(Cl(GOOGL_peaks1)) )
