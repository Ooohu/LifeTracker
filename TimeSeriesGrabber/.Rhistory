BullPeriod$min_date,
BullPeriod$peak_date
)
fluc_pct <- as.numeric(fluc_pct)
fluc_pct <- fluc_pct[!is.na(fluc_pct)]
# -------------------------
# t-distribution FIT
# -------------------------
fit <- fitdist(fluc_pct, "t")
mu <- fit$estimate["m"]
sigma <- fit$estimate["sd"]
df <- fit$estimate["df"]
# VaR using t-distribution
VaR_05 <- mu + sigma * qt(0.05, df = df)
worst_drop <- min(fluc_pct)
# -------------------------
# weighting
# -------------------------
frac1 <- input$frac1
frac2 <- 1 - frac1
risk_score <- frac1 * VaR_05 + frac2 * worst_drop
# -------------------------
# store table
# -------------------------
rv$results <- rbind(
rv$results,
data.frame(
Symbol = symbol,
VaR_05 = VaR_05,
Worst_drop = worst_drop,
Frac1 = frac1,
Frac2 = frac2,
Risk = risk_score
)
)
write.csv(rv$results, file_path, row.names = FALSE)
selected_data(list(
fluc = fluc_pct,
mu = mu,
sigma = sigma,
df = df
))
})
# -------------------------
# DT TABLE (sortable + filterable)
# -------------------------
output$resultsTable <- renderDT({
datatable(
rv$results,
options = list(
pageLength = 10,
scrollX = TRUE
)
)
})
# -------------------------
# t-distribution plot (approx via normal overlay not used)
# -------------------------
output$gaussPlot <- renderPlot({
req(selected_data())
d <- selected_data()
hist(d$fluc,
breaks = 50,
probability = TRUE,
main = "t-Distribution Fit",
xlab = "% Change",
col = "lightblue")
curve(dt((x - d$mu) / d$sigma, df = d$df) / d$sigma,
add = TRUE,
col = "red",
lwd = 2)
})
}
# -----------------------------
# Run app
# -----------------------------
shinyApp(ui, server)
