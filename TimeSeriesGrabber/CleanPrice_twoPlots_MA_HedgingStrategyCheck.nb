Cell[CellGroupData[{

Cell["Hedging Strategy", "Section",
 CellChangeTimes->{{3.989144329838225*^9, 
  3.9891443350115767`*^9}},ExpressionUUID->"13ad403b-a4e2-4066-9126-\
18488c8eb895"],

Cell["\<\
Hedging sizing with MA20 and MA50:
Parameters: WgtMa20=0.5, WgtMa20=0.5, SenseScale
\[LineSeparator]T20 = (P - MA20) / MA20
T50 = (P - MA50) / MA50
S = WgtMa20 * T20 + (1 - WgtMa20) * T50

Primary = Clip(0.5 + SenseScale*S)
Hedge = Clip(0.5 - SenseScale*S)
Cash = 1- Primary - Hedge\:202d\:202c\:202d\:202c\:202d\:202c\:202d\:202c\
\:202d\:202c\:202d\:202c\:202d\:202c\:202d\:202c\:202d\:202c\:202d\:202c\:202d\
\:202c\
\>", "Text",
 CellChangeTimes->{{3.988974728217184*^9, 3.98897488360235*^9}, {
  3.9891443776145144`*^9, 3.9891444195014353`*^9}, {3.989148752533205*^9, 
  3.989148753914431*^9}, {3.989162349957734*^9, 
  3.989162353138831*^9}},ExpressionUUID->"2e9678a2-9fb5-4217-98f4-\
9b45e88dd39a"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"T20", "[", 
    RowBox[{"price_", ",", "ma20_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"price", "-", "ma20"}], ")"}], "/", "ma20"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"T50", "[", 
    RowBox[{"price_", ",", "ma50_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"price", "-", "ma50"}], ")"}], "/", "ma50"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"ScaleF", "[", 
    RowBox[{"price_", ",", "ma20_", ",", "ma50_", ",", "Wgt_"}], "]"}], ":=", 
   
   RowBox[{
    RowBox[{"Wgt", "*", 
     RowBox[{"T20", "[", 
      RowBox[{"price", ",", "ma20"}], "]"}]}], "+", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"1", "-", "Wgt"}], ")"}], "*", 
     RowBox[{"T50", "[", 
      RowBox[{"price", ",", "ma50"}], "]"}]}]}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.988973663763792*^9, 3.988973737007605*^9}, {
