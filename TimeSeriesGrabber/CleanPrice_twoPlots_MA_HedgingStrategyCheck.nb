Notebook[{
Cell["\<\
Hedging Strategy with MA20 and MA50;\[LineSeparator]T_{20} = \\frac{P - \
MA_{20}}{MA_{20}}
T_{50} = \\frac{P - MA_{50}}{MA_{50}}
S=WgtMa20*T_20 + (1-WgtMa20)*T_50

Primary = Clip(0.5 + SenseScale*S)
Hedge = Clip(0.5 - SenseScale*S)
Cash = 1- Primary - Hedge\:202d\:202c\:202d\:202c\:202d\:202c\:202d\:202c\
\:202d\:202c\:202d\:202c\:202d\:202c\:202d\:202c\:202d\:202c\:202d\:202c\:202d\
\:202c\
\>", "Text",
 CellChangeTimes->{{3.988974728217184*^9, 
  3.98897488360235*^9}},ExpressionUUID->"2e9678a2-9fb5-4217-98f4-\
9b45e88dd39a"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"T20", "[", 
    RowBox[{"price_", ",", "ma20_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"price", "-", "ma20"}], ")"}], "/", "ma20"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"T50", "[", 
    RowBox[{"price_", ",", "ma50_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"price", "-", "ma50"}], ")"}], "/", "ma50"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"ScaleF", "[", 
    RowBox[{"price_", ",", "ma20_", ",", "ma50_", ",", "Wgt_"}], "]"}], ":=", 
   
   RowBox[{
    RowBox[{"Wgt", "*", 
     RowBox[{"T20", "[", 
      RowBox[{"price", ",", "ma20"}], "]"}]}], "+", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"1", "-", "Wgt"}], ")"}], "*", 
     RowBox[{"T50", "[", 
      RowBox[{"price", ",", "ma50"}], "]"}]}]}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.988973663763792*^9, 3.988973737007605*^9}, {
  3.988973771575642*^9, 3.988973816483841*^9}, {3.988973987659958*^9, 
